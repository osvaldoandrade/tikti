          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(tikti_saml_response_validation_duration_seconds_bucket{tid=~\"$tid\"}[$__rate_interval])) by (le))",
          "legendFormat": "P99",
          "range": true,
          "refId": "B"
